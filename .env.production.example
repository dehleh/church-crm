# ==============================================================================
# ChurchOS Self-Hosted Production Environment Variables
# Example for: The Baptising Church (tbc.lekki.org / cos.tbclekki.org)
# ==============================================================================

# Database Settings
DB_USER=churchos
DB_PASSWORD=change_this_to_a_strong_password_in_production
DB_NAME=churchos_db
DATABASE_URL=postgres://churchos:change_this_to_a_strong_password_in_production@postgres:5432/churchos_db

# Security & Secrets (Generate strong random 64-char strings)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_at_least_32_characters_long

# URLs & Domains
APP_URL=https://cos.tbclekki.org
API_URL=https://cos.tbclekki.org/api
HTTP_PORT=80

# Storage (local persistent disk or aws_s3)
STORAGE_DRIVER=local

# Outbound Email (SMTP)
SMTP_HOST=mail.tbclekki.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@tbclekki.org
SMTP_PASS=your_email_account_password
SMTP_FROM=notifications@tbclekki.org

# Optional SMS Gateway (Termii for Africa/Nigeria or Twilio Global)
TERMII_API_KEY=
TERMII_SENDER_ID=TBC_LEKKI

# Optional WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
