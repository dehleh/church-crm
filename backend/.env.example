# Server
PORT=5000
NODE_ENV=development

# Database — use DATABASE_URL (Railway) OR individual vars below
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=church_crm
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# App
APP_NAME=ChurchOS
APP_URL=https://cos.themobilemissionary.org
API_URL=https://cos.themobilemissionary.org/api

# Platform Super Admin (Company Engineering Console)
# Default if unset: superadmin@churchos.platform / PlatformAdmin2026!
PLATFORM_ADMIN_EMAIL=superadmin@churchos.platform
PLATFORM_ADMIN_PASSWORD=PlatformAdmin2026!
